{
  "name": "discord-event-manager",
  "version": "1.62.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,css}\"",
    "version:bump": "npm version --no-git-tag-version --workspaces=false"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
