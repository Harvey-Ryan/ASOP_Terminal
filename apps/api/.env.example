PORT=3001
WEB_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default – zero config local dev)
DATABASE_URL="file:./dev.db"
# PostgreSQL (production)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/dem?schema=public"

# ── Discord OAuth ─────────────────────────────────────────────────────────────
# Create an app at https://discord.com/developers/applications
# OAuth2 → Redirects → add http://localhost:3001/api/auth/callback
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/callback

# ── Session ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_64_char_random_hex_string
