// Prisma schema for Discord Event Manager

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── User & Auth ───────────────────────────────────────────────────────────────

/// Application user – one record per Discord account that has logged in.
model User {
  id            String   @id @default(cuid())
  discordId     String   @unique     // Discord snowflake
  username      String
  discriminator String
  globalName    String?
  avatar        String?
  email         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rsiHandle    String?

  accounts           Account[]
  guildMembers       GuildMember[]
  templates          EventTemplate[]
  fleetyardsLink     FleetyardsLink?
  notificationPrefs  UserNotificationPrefs?
}

/// OAuth tokens for a user/provider pair.
/// Supports multiple providers in the future (e.g. a second Discord account).
model Account {
  id                String   @id @default(cuid())
  provider          String   // "discord"
  providerAccountId String   // Discord user snowflake
  accessToken       String
  refreshToken      String?
  expiresAt         Int?     // Unix timestamp
  tokenType         String?
  scope             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ── Guild ────────────────────────────────────────────────────────────────────

/// A Discord server the app has been introduced to.
/// All event data is strictly scoped by guildId (the Discord snowflake).
model Guild {
  id        String   @id @default(cuid())
  guildId   String   @unique   // Discord snowflake – the canonical multi-tenant key
  name      String
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings        GuildSettings?
  members         GuildMember[]
  templates       EventTemplate[]
  allianceMembers AllianceMember[]
  eventShares     EventGuildShare[]
}

/// The role a User holds within a Guild.
model GuildMember {
  id        String   @id @default(cuid())
  /// OWNER | ADMIN | ORGANIZER | MEMBER
  role      String   @default("MEMBER")
  /// Per-guild RSI citizen handle (distinct from User.rsiHandle which is fleet-only)
  rsiHandle      String?
  /// True once the member has completed the bio-token verification flow for this guild
  rsiVerified    Boolean  @default(false)
  /// Pending verification token — cleared on successful verify
  rsiVerifyToken String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId  String
  guildId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([userId, guildId])
  @@index([guildId])
}

/// Per-guild configuration for bot features and channel routing.
/// Created on first bot interaction; all fields are optional until configured.
model GuildSettings {
  id              String   @id @default(cuid())
  /// Discord channel snowflake for posting forum threads
  forumChannelId  String?
  /// Discord channel snowflake for Discord Scheduled Events
  eventChannelId  String?
  /// Discord category snowflake for auto-created voice channels
  voiceCategoryId String?
  /// Discord channel snowflake for loot roll output
  lootChannelId   String?
  timezone        String   @default("UTC")
  /// JSON: string[] — Discord role snowflake IDs allowed to create events (empty = admin-only)
  eventCreatorRoles String @default("[]")
  /// JSON: string[] — Discord role snowflake IDs allowed to edit module settings (empty = admin-only)
  moduleEditorRoles String @default("[]")
  /// JSON: string[] — Discord role snowflake IDs allowed to view events and loot on the dashboard
  viewerRoles       String @default("[]")
  /// Custom label for the DKP currency shown throughout the UI and bot messages (e.g. "Credits", "Points")
  dkpLabel          String @default("DKP")
  /// Discord channel snowflake for standalone DKP auction announcements
  dkpAnnouncementChannelId String?
  /// JSON: string[] — Discord role snowflake IDs allowed to create standalone loot sessions (empty = manager-only)
  lootDraftCreatorRoles String @default("[]")
  /// Whether the Event Bot module is enabled for this guild
  eventBotEnabled       Boolean  @default(true)
  /// Whether the DKP / Auctions module is enabled for this guild
  dkpEnabled            Boolean  @default(true)
  /// Whether the Loot module is enabled for this guild
  lootEnabled           Boolean  @default(true)
  /// Whether the Exchange module is enabled for this guild
  exchangeEnabled       Boolean  @default(true)
  /// Whether the Fleet Registry module is enabled for this guild
  fleetEnabled          Boolean  @default(true)
  /// Whether the Blueprints module is enabled for this guild
  blueprintsEnabled     Boolean  @default(true)
  /// Whether the Crafting Calculator module is enabled for this guild
  craftingEnabled       Boolean  @default(true)
  /// Whether the Activity (RoleCallBot) module is enabled for this guild
  activityEnabled       Boolean  @default(true)
  /// Default duration in hours for new standalone DKP auctions (1–168)
  dkpDefaultAuctionDuration Int  @default(24)
  /// Minimum valid bid amount for DKP auctions (0 = no minimum)
  dkpMinBid             Int      @default(0)
  /// Default loot method for new sessions: RANDOM_ROLL | DKP | SNAKE_DRAFT
  lootDefaultMethod     String   @default("RANDOM_ROLL")
  /// RSI org tag for roster sync (e.g. "ASOP")
  rsiOrgTag             String?
  /// Short 4-char alphanumeric tag identifying this guild in alliance context (e.g. "ASOP")
  allianceTag           String?
  /// JSON: string[] — Discord role snowflake IDs allowed to manage alliances (empty = guild-manager-only)
  allianceManagerRoles  String   @default("[]")
  /// Whether regular members can see the Guild Activity and Event Planning heat maps
  activityHeatmapPublic Boolean  @default(true)
  /// Whether the Tournaments module is enabled for this guild
  tournamentsEnabled    Boolean  @default(true)
  /// Discord forum channel snowflake where tournament threads are created by default
  tournamentChannelId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

// ── Events ────────────────────────────────────────────────────────────────────

/// A scheduled event within a guild.
model Event {
  id             String    @id @default(cuid())
  guildId        String
  name           String
  description    String?
  /// Free-text assembly location shown in the embed and Discord event
  musterPoint    String?
  startTime      DateTime
  endTime        DateTime?

  discordEventId  String?
  threadId        String?
  /// Discord message snowflake for the roster embed (first message in the thread)
  rosterMessageId String?
  /// JSON: string[] — Discord VC channel snowflakes created for this event
  vcIds           String   @default("[]")

  /// DAILY | WEEKLY | BIWEEKLY | MONTHLY — null means one-off
  recurType       String?
  /// Stop spawning new occurrences after this UTC datetime. Null = no end date.
  recurEndsAt     DateTime?
  /// JSON: {name:string,count:number}[] — role slots defined by the organiser
  roles           String   @default("[]")
  /// JSON: string[] — VC names to create 30 min before start
  vcNames         String   @default("[]")
  /// Whether to create an additional PTT-enforced Briefing VC for this event
  briefingChannel Boolean  @default(false)
  /// URL path to cover image stored in the server image library
  imageUrl        String?

  /// PENDING | ACTIVE | ENDED | COMPLETED
  status          String   @default("PENDING")
  /// Last time at least one event VC had a member present (for inactivity detection)
  lastVcActivityAt DateTime?
  /// Set when the admin completes the loot prompt on the web dashboard
  hadLoot         Boolean?
  lootNotes       String?
  /// JSON: string[] — Discord user IDs that were active in event VCs when the event ended
  vcAttendees     String   @default("[]")
  /// JSON: string[] — user IDs confirmed as attendees after the audit
  confirmedAttendees String?
  /// Set by the bot after it finishes VC cleanup / thread archiving
  botCleanedUp    Boolean  @default(false)
  /// Set when endEvent() first runs — prevents duplicate thread messages on scheduler retries
  botEndedAt      DateTime?
  /// Set when event VCs first become empty after ENDED — drives the 5-min deletion timer
  vcsEmptiedAt    DateTime?
  /// Set true once the bot has posted the "event is live" message at start time
  livePosted      Boolean  @default(false)
  /// JSON: EventPoll — poll config posted to the forum thread alongside the embed
  pollData        String?

  /// Optional alliance this event is shared across
  allianceId     String?

  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rsvps          EventRsvp[]
  reminders      EventReminder[]
  alliance       Alliance?            @relation(fields: [allianceId], references: [id], onDelete: SetNull)
  allianceGuilds EventAllianceGuild[]
  guildShares    EventGuildShare[]

  @@index([guildId])
  @@index([startTime])
  @@index([status])
  @@index([allianceId])
}

/// A roster entry — created when a user clicks Interested or a role button.
model EventRsvp {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  username  String
  /// null = Unassigned; otherwise the role name the user claimed
  role      String?
  updatedAt DateTime @default(now()) @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}

/// A scheduled reminder for an event.
model EventReminder {
  id      String   @id @default(cuid())
  eventId String
  sendAt  DateTime
  sent    Boolean  @default(false)
  /// FORUM = post in thread; DM = direct-message all roster members
  type    String   @default("FORUM")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([sendAt, sent])
}

/// A per-server image uploaded via the web dashboard.
model ServerImage {
  id        String   @id @default(cuid())
  guildId   String
  filename  String
  /// Web-accessible URL path, e.g. /uploads/{guildId}/{filename}
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([guildId, sortOrder])
}

// ── Loot ─────────────────────────────────────────────────────────────────────

/// One loot distribution session — attached to an event or standalone.
model LootSession {
  id           String   @id @default(cuid())
  eventId      String?  @unique
  guildId      String
  /// Human-readable label for standalone sessions
  name         String?
  /// RANDOM_ROLL | DKP | SNAKE_DRAFT
  method       String   @default("RANDOM_ROLL")
  /// OPEN | COMPLETED
  status       String   @default("OPEN")
  /// JSON: string[] — userId order for snake draft
  draftOrder   String   @default("[]")
  /// JSON: [{userId, username}] — participant pool for standalone sessions
  participants String   @default("[]")
  /// Number of skipped turns applied to the draft position
  skipCount     Int      @default(0)
  /// True once the manager clicks Start Draft — locks shuffle and triggers first picker DM
  draftStarted  Boolean  @default(false)
  /// Number of snake draft rounds (1–10); draft ends when all items claimed OR rounds × players picks made
  totalRounds   Int      @default(1)
  /// DKP points awarded to each confirmed attendee on completion (event sessions only)
  dkpAward   Int      @default(0)
  /// Discord snowflake of the user who created this standalone session; null for event-linked sessions
  ownerId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items      LootItem[]
  queueItems LootDraftQueue[]

  @@index([guildId])
  @@index([status, guildId])
}

model LootItem {
  id                 String   @id @default(cuid())
  sessionId          String
  name               String
  quantity           Int      @default(1)
  qualityLevel       Int?
  excludePrevWinners Boolean  @default(false)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())

  session      LootSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignments  LootAssignment[]
  auction      LootAuction?
  queueEntries LootDraftQueue[]

  @@index([sessionId])
}

/// One winner record per item (quantity > 1 can have multiple rows).
model LootAssignment {
  id          String    @id @default(cuid())
  itemId      String
  userId      String
  username    String
  rollValue   Int?
  dkpSpent    Int?
  pickNumber  Int?
  assignedAt  DateTime  @default(now())
  delivered   Boolean   @default(false)
  deliveredAt DateTime?

  item LootItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

/// Per-user priority queue for snake draft auto-pick.
/// Rows are deleted when the item is assigned to anyone.
model LootDraftQueue {
  id        String   @id @default(cuid())
  sessionId String
  userId    String   // Discord snowflake
  itemId    String
  /// Lower value = higher priority (0 = first pick)
  priority  Int
  createdAt DateTime @default(now())

  session LootSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item    LootItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId, itemId])
  @@index([sessionId, userId])
  @@index([itemId])
}

/// Running DKP balance per guild member.
model DkpBalance {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  username  String
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  transactions DkpTransaction[]

  @@unique([guildId, userId])
  @@index([guildId])
}

model DkpTransaction {
  id        String   @id @default(cuid())
  balanceId String
  guildId   String
  userId    String
  username  String
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  balance DkpBalance @relation(fields: [balanceId], references: [id], onDelete: Cascade)

  @@index([balanceId])
  @@index([guildId, userId])
}

// ── Bot Config ────────────────────────────────────────────────────────────────

/// Singleton application-level bot configuration (always id = 1).
model BotConfig {
  id                    Int     @id @default(1)
  globalCommandsEnabled Boolean @default(true)
}

// ── Repeat Templates ──────────────────────────────────────────────────────────

/// Canonical event blueprint created (or updated) each time a user clicks "Repeat"
/// on a COMPLETED event or picks a template from the Templates list.
/// Deduped by guildId + name; every actual use is recorded in RepeatTemplateUse.
model RepeatTemplate {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  description String?
  musterPoint String?
  /// JSON: EventRole[]  – [{name,count}]
  roles       String   @default("[]")
  /// JSON: string[]
  vcNames         String   @default("[]")
  /// Whether to create an additional PTT-enforced Briefing VC for this event
  briefingChannel Boolean  @default(false)
  imageUrl        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  uses RepeatTemplateUse[]

  @@unique([guildId, name])
  @@index([guildId])
}

/// One row per time a RepeatTemplate was used to create a new event.
model RepeatTemplateUse {
  id         String         @id @default(cuid())
  templateId String
  usedAt     DateTime       @default(now())

  template RepeatTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, usedAt])
}

// ── Event Templates ───────────────────────────────────────────────────────────

/// A reusable event blueprint scoped to a single guild.
/// Auto-created (or updated) when a user clicks Repeat on a completed event.
/// Surfaced only through the Templates button in the create-event form.
model EventTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  musterPoint String?

  // JSON: EventRole[]   – [{name, count}]
  roles           String @default("[]")
  // JSON: string[]
  vcNames         String @default("[]")
  briefingChannel Boolean @default(false)
  // JSON: RosterSlot[]  – [{ id, name, emoji?, maxCount, required }]
  rosterSlots     String @default("[]")
  // JSON: number[]      – minutes before event start, e.g. [1440, 60, 15]
  reminderMinutes String @default("[1440,60]")

  defaultDuration Int?
  isActive        Boolean @default(true)
  /// Stable link to the source Event.id — used as the upsert key so template
  /// identity never changes even when the event name is edited.
  sourceEventId   String? @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  guildId     String
  guild       Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  uses EventTemplateUse[]

  @@index([guildId])
  @@index([createdById])
}

// ── Loot Auctions ─────────────────────────────────────────────────────────────

/// Live DKP auction for a single loot item. One auction per item at a time.
model LootAuction {
  id               String    @id @default(cuid())
  itemId           String    @unique
  sessionId        String
  guildId          String
  startedById      String
  durationSecs     Int       @default(120)
  closesAt         DateTime
  /// OPEN | CLOSED | CANCELLED
  status           String    @default("OPEN")
  winnerId         String?
  winnerUsername   String?
  winningBid       Int?
  /// Discord message snowflake in the event thread — edited on every bid update
  discordMessageId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  item LootItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  bids LootAuctionBid[]

  @@index([guildId, status])
  @@index([closesAt, status])
}

/// Current standing bid per player per auction. One row per user; upserted on raise (amount only ever increases).
model LootAuctionBid {
  id        String   @id @default(cuid())
  auctionId String
  userId    String
  username  String
  amount    Int
  maxBid    Int      @default(0)
  placedAt  DateTime @default(now()) @updatedAt

  auction LootAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@unique([auctionId, userId])
  @@index([auctionId])
}

/// One row per time an EventTemplate was used to create a new event.
model EventTemplateUse {
  id         String        @id @default(cuid())
  templateId String
  usedAt     DateTime      @default(now())

  template EventTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, usedAt])
}

// ── Standalone Auctions ───────────────────────────────────────────────────────

/// A guild-scoped DKP auction not tied to any event or loot session.
model Auction {
  id               String   @id @default(cuid())
  guildId          String
  eventId          String?
  title            String
  description      String?
  startedById      String
  durationSecs     Int      @default(120)
  closesAt         DateTime
  status           String   @default("OPEN")
  winnerId         String?
  winnerUsername   String?
  winningBid       Int?
  discordMessageId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bids AuctionBid[]

  @@index([guildId, status])
  @@index([closesAt, status])
  @@index([eventId])
}

model AuctionBid {
  id        String   @id @default(cuid())
  auctionId String
  userId    String
  username  String
  amount    Int
  maxBid    Int      @default(0)
  placedAt  DateTime @default(now()) @updatedAt

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@unique([auctionId, userId])
  @@index([auctionId])
}

// ── Star Citizen scunpacked Blueprint Cache ───────────────────────────────────
// Global tables — not guild-scoped. Populated by syncing blueprints.json
// from https://github.com/StarCitizenWiki/scunpacked-data

/// A craftable blueprint extracted from scunpacked-data.
model ScBlueprint {
  uuid                String   @id
  key                 String   @unique
  kind                String
  outputUuid          String
  outputName          String
  outputClass         String
  outputType          String
  outputSubtype       String?
  outputGrade         String?
  categoryUuid        String?
  dismantleTimeSecs   Int?
  dismantleEfficiency Float?
  syncedAt            DateTime @updatedAt

  tiers       ScBlueprintTier[]
  rewardPools ScBlueprintRewardPool[]

  @@index([outputName])
  @@index([outputType])
}

/// One craft tier per blueprint (multiple tiers = different quality paths).
model ScBlueprintTier {
  id            String @id @default(cuid())
  blueprintUuid String
  tierIndex     Int
  craftTimeSecs Int

  blueprint ScBlueprint          @relation(fields: [blueprintUuid], references: [uuid], onDelete: Cascade)
  materials ScBlueprintMaterial[]
  modifiers ScBlueprintModifier[]

  @@unique([blueprintUuid, tierIndex])
  @@index([blueprintUuid])
}

/// A single required material or resource within a blueprint tier.
model ScBlueprintMaterial {
  id          String  @id @default(cuid())
  tierId      String
  kind        String  // "resource" | "item"
  name        String
  itemUuid    String?
  quantityScu Float?  // bulk resources measured in SCU
  quantity    Int?    // discrete items measured in count
  minQuality  Int?
  groupKey    String? // parent group name for display grouping

  tier ScBlueprintTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@index([tierId])
  @@index([name])
}

/// A quality-scaling stat modifier attached to a blueprint tier.
model ScBlueprintModifier {
  id            String  @id @default(cuid())
  tierId        String
  key           String  // e.g. "health_maxhealth", "weapon_damage"
  name          String
  unitFormat    String?
  qualityMin    Int
  qualityMax    Int
  modifierAtMin Float
  modifierAtMax Float

  tier ScBlueprintTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@index([tierId])
}

/// Links a blueprint to a mission reward pool UUID.
model ScBlueprintRewardPool {
  id            String @id @default(cuid())
  blueprintUuid String
  poolUuid      String
  poolKey       String

  blueprint ScBlueprint @relation(fields: [blueprintUuid], references: [uuid], onDelete: Cascade)

  @@index([blueprintUuid])
  @@index([poolUuid])
}

/// A Star Citizen mission that can reward blueprints (populated when mission data is available).
model ScMission {
  uuid         String  @id
  name         String
  description  String?
  faction      String?
  missionType  String?
  missionGiver String?
  locationName String?
  syncedAt     DateTime @default(now()) @updatedAt

  rewardPools ScMissionRewardPool[]

  @@index([name])
  @@index([faction])
}

/// Junction table linking a mission to the reward pool UUIDs it can grant.
model ScMissionRewardPool {
  id          String @id @default(cuid())
  missionUuid String
  poolUuid    String

  mission ScMission @relation(fields: [missionUuid], references: [uuid], onDelete: Cascade)

  @@unique([missionUuid, poolUuid])
  @@index([missionUuid])
  @@index([poolUuid])
}

/// Immutable audit log — one row per scunpacked sync run.
model ScSyncLog {
  id                String    @id @default(cuid())
  trigger           String    // "MANUAL" | "SCHEDULED"
  status            String    @default("RUNNING") // "RUNNING" | "SUCCESS" | "FAILED"
  blueprintsAdded   Int       @default(0)
  blueprintsUpdated Int       @default(0)
  /// JSON: per-type record counts for full sync runs
  detailsJson       String?
  error             String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?

  @@index([status])
  @@index([startedAt])
}

/// Star Citizen manufacturer directory.
model ScManufacturer {
  uuid        String   @id
  code        String?
  name        String
  description String?
  syncedAt    DateTime @updatedAt

  @@index([name])
}

/// One entry per location/POI in the in-game starmap.
model ScStarmapEntry {
  uuid          String   @id
  name          String
  description   String?
  parentUuid    String?
  navIcon       String?
  type          String   // e.g. "PointOfInterest", "NavPoint", "Outpost"
  isScannable   Boolean  @default(false)
  hideInStarmap Boolean  @default(false)
  size          Float?
  amenitiesJson String?
  syncedAt      DateTime @updatedAt

  @@index([name])
  @@index([type])
  @@index([parentUuid])
}

/// A location that produces or consumes tagged commodities.
model ScTradeLocation {
  uuid             String   @id
  className        String   @unique
  displayName      String?
  disabled         Boolean  @default(false)
  producesTagsJson String?
  consumesTagsJson String?
  syncedAt         DateTime @updatedAt

  @@index([displayName])
}

/// UUID → tag-name lookup from tags.json.
model ScTag {
  uuid     String @id
  name     String

  @@index([name])
}

/// In-game commodity definition from scunpacked resources/commodities.json.
model ScCommodity {
  uuid               String   @id
  key                String   @unique
  name               String
  description        String?
  refinedVersionUuid String?
  refinedVersionName String?
  tier               String?
  densityGPerCc      Float?
  instability        Float?
  resistance         Float?
  syncedAt           DateTime @updatedAt

  @@index([name])
  @@index([tier])
}

/// Resource harvestable location provider from resources/locations.json.
model ScResourceLocation {
  uuid          String   @id
  providerName  String
  presetFile    String   @unique
  locationsJson String   // JSON: Location[]
  areasJson     String?  // JSON: Area[]
  groupsJson    String?  // JSON: Group[] with Deposits
  syncedAt      DateTime @updatedAt
}

// ── Event Guild Shares ────────────────────────────────────────────────────────

enum ShareSource {
  ALLIANCE
  DIRECT
}

enum ShareStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// Invite record for sharing an event with a non-host guild.
/// One row per (event, receiving guild); status tracks the invite lifecycle.
/// @@unique enforces a guild can appear in an event exactly once regardless of source.
model EventGuildShare {
  id          String      @id @default(cuid())
  eventId     String
  guildId     String      // internal Guild.id (receiving guild — never the host)
  sourceType  ShareSource
  allianceId  String?     // set when sourceType = ALLIANCE
  status      ShareStatus @default(PENDING)
  invitedAt   DateTime    @default(now())
  respondedAt DateTime?

  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guild         Guild               @relation(fields: [guildId], references: [id], onDelete: Cascade)
  allianceGuild EventAllianceGuild?

  @@unique([eventId, guildId])
  @@index([eventId])
  @@index([guildId])
  @@index([status])
}

// ── Alliances ─────────────────────────────────────────────────────────────────

/// A named grouping of guilds for cross-org organisation.
model Alliance {
  id        String           @id @default(cuid())
  name      String
  isDirect  Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  members AllianceMember[]
  events  Event[]
}

/// Junction table — one row per guild in an Alliance.
model AllianceMember {
  id               String   @id @default(cuid())
  allianceId       String
  guildId          String
  /// PENDING (awaiting acceptance) | ACCEPTED
  status           String   @default("PENDING")
  /// Discord snowflake of the guild that sent the invitation
  invitedByGuildId String?
  createdAt        DateTime @default(now())

  alliance Alliance @relation(fields: [allianceId], references: [id], onDelete: Cascade)
  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([allianceId, guildId])
  @@index([allianceId])
  @@index([guildId])
  @@index([status])
}

/// Per-guild Discord entities for an alliance-shared event (non-host guilds).
model EventAllianceGuild {
  id              String   @id @default(cuid())
  eventId         String
  /// Discord snowflake for the alliance member guild
  discordGuildId  String
  threadId        String?
  rosterMessageId String?
  discordEventId  String?
  /// The EventGuildShare that triggered this Discord setup. Nullable for rows created before
  /// this field was introduced and for any legacy code paths that don't set it.
  /// @unique: one share → at most one EventAllianceGuild row.
  /// OnDelete: SetNull so deleting the share preserves the record for cleanup (thread + scheduled
  /// event still need explicit archiving before the row can be safely removed).
  shareId         String?  @unique
  createdAt       DateTime @default(now())

  event Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  share EventGuildShare? @relation(fields: [shareId], references: [id], onDelete: SetNull)

  @@unique([eventId, discordGuildId])
  @@index([eventId])
}

/// Minable / harvestable resource definition from resources/resources.json.
model ScResource {
  uuid            String   @id
  key             String   @unique
  name            String
  kind            String
  harvestableUuid String?
  harvestableKey  String?
  tier            String?
  syncedAt        DateTime @updatedAt

  @@index([name])
  @@index([kind])
}

/// Localization label map from labels.json (key → display string).
model ScLabel {
  key      String   @id
  value    String
  syncedAt DateTime @updatedAt

  @@index([value])
}

/// Ship component / item from ship-items.json (weapons, shields, drives, etc.).
model ScShipItem {
  uuid             String   @id
  className        String   @unique
  itemName         String
  type             String
  subType          String?
  size             Int?
  grade            Int?
  name             String?
  classification   String?
  tags             String?
  manufacturerCode String?
  manufacturerName String?
  manufacturerUuid String?
  description      String?
  mass             Float?
  inventoryScu     Float?
  stdItemJson      String   // full stdItem blob
  syncedAt         DateTime @updatedAt

  @@index([name])
  @@index([type])
  @@index([classification])
  @@index([manufacturerCode])
}

// ── UEX Corp Game Data Cache ──────────────────────────────────────────────────
// Global tables — not guild-scoped. Populated by the weekly UEX API sync.
// API key is read from UEX_KEY environment variable at sync time.

/// UEX item category (mirrors /categories endpoint).
model UexCategory {
  /// UEX's own integer ID — used as the stable upsert key.
  id           Int      @id
  type         String   // "item" | "service" | "contract"
  section      String
  name         String
  /// Raw dateModified string from UEX — used to detect upstream changes.
  dateModified String
  syncedAt     DateTime @updatedAt

  items UexItem[]

  @@index([type])
  @@index([section])
}

/// UEX item (ship component, weapon, equipment — mirrors /items + /items_attributes).
model UexItem {
  /// UEX's own integer ID — used as the stable upsert key.
  id            Int      @id
  name          String
  slug          String
  uuid          String?
  section       String?
  categoryId    Int
  categoryName  String
  size          String?
  isCommodity   Boolean  @default(false)
  isHarvestable Boolean  @default(false)
  gameVersion   String?
  /// JSON: {name:string, value:string, unit:string}[] — from /items_attributes.
  attributes    String   @default("[]")
  /// Raw dateModified string from UEX — drives attribute re-fetch on change.
  dateModified  String
  /// False when an item disappears from UEX without a hard delete.
  isActive      Boolean  @default(true)
  syncedAt      DateTime @updatedAt

  category UexCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([name])
  @@index([isActive])
}

/// UEX commodity (trade good — mirrors /commodities endpoint).
model UexCommodity {
  /// UEX's own integer ID — used as the stable upsert key.
  id            Int      @id
  name          String
  code          String
  slug          String
  weightScu     Float?
  priceAvgBuy   Float?
  priceAvgSell  Float?
  isMineral     Boolean  @default(false)
  isRaw         Boolean  @default(false)
  isRefined     Boolean  @default(false)
  isHarvestable Boolean  @default(false)
  isFuel        Boolean  @default(false)
  isIllegal     Boolean  @default(false)
  /// Raw dateModified string from UEX — used to detect upstream changes.
  dateModified  String
  /// False when a commodity disappears from UEX without a hard delete.
  isActive      Boolean  @default(true)
  syncedAt      DateTime @updatedAt

  @@index([name])
  @@index([isActive])
  @@index([isIllegal])
}

// ── Marketplace (member inventory + cross-guild listings) ────────────────────

enum TradeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// One inventory slot per member per item per location. Unique on (guildId, userId, itemType, externalItemId, location).
/// When forSale is true the entry is visible on the cross-guild marketplace.
model InventoryEntry {
  id             String   @id @default(cuid())
  guildId        String
  /// Discord user snowflake
  userId         String
  /// Display name at the time of last update
  username       String
  /// "ITEM" | "COMMODITY"
  itemType       String
  /// UEX item or commodity numeric ID
  externalItemId Int
  /// Denormalised name for display without re-joining UEX tables
  itemName       String
  /// Quantity; float to support fractional SCU for commodities
  quantity       Float
  /// Quality level 0-100 (minerals/commodities only); null for discrete items
  qualityLevel   Int?
  /// Free-text location, e.g. "Lorville - TDD"
  location       String?
  /// False when the member has left the guild. Entries are preserved but
  /// hidden from search results and /whohas. Reset to true on rejoin.
  memberActive   Boolean  @default(true)
  /// Whether this entry is publicly listed on the marketplace
  forSale        Boolean  @default(false)
  /// Quantity available for sale; null means all of quantity
  quantityListed Float?
  /// Asking price in whole aUEC; null when priceNote is used instead
  askingPrice    Int?
  /// Free-text price note e.g. "Negotiable" or "Trade for Agricium"
  priceNote      String?
  /// Timestamp of when this entry was last listed (or re-listed with a new price).
  /// Null until first listed. Cleared when unlisted. Soft-expiry check uses this field.
  listedAt       DateTime?

  trades         Trade[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([guildId, itemType, externalItemId])
  @@index([guildId, userId])
  @@index([guildId, memberActive])
  @@index([guildId, userId, itemType, externalItemId, location, qualityLevel])
  @@index([forSale, memberActive, itemType, externalItemId])
}

/// A buyer's request to purchase a marketplace listing.
/// listingSnapshot captures the listing state at request time for history.
model Trade {
  id                String      @id @default(cuid())
  inventoryEntryId  String
  inventoryEntry    InventoryEntry @relation(fields: [inventoryEntryId], references: [id], onDelete: Cascade)
  /// Denormalised snapshot of the listing at the moment the trade was requested
  listingSnapshot   Json
  buyerGuildId      String
  buyerId           String
  buyerUsername     String
  quantityRequested Float
  /// Optional message from the buyer to the seller
  note              String?
  status            TradeStatus @default(PENDING)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  messages  TradeMessage[]

  @@index([inventoryEntryId, status])
  @@index([buyerId])
}

/// A message sent between buyer and seller during trade negotiation.
model TradeMessage {
  id              String   @id @default(cuid())
  tradeId         String
  trade           Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  senderId        String
  senderUsername  String
  body            String   @db.Text
  createdAt       DateTime @default(now())

  @@index([tradeId, createdAt])
}

/// Tracks when a trade party last viewed the messages for a trade.
/// Used to compute the unread message badge on the Trades tab.
model TradeMessageRead {
  tradeId    String
  userId     String
  lastReadAt DateTime @default(now())

  @@id([tradeId, userId])
  @@index([userId])
}

// ── Notification Preferences ─────────────────────────────────────────────────

/// Per-user opt-out toggles for Discord DM notifications.
/// All fields default true (opt-out model); a row is created on first PUT.
model UserNotificationPrefs {
  userId           String  @id
  /// DM when someone requests a trade on your listing (you're the seller)
  dmTradeRequest   Boolean @default(true)
  /// DM when your trade request is accepted or declined (you're the buyer)
  dmTradeStatus    Boolean @default(true)
  /// DM when the other party cancels a trade
  dmTradeCancelled Boolean @default(true)
  /// DM when you receive a new message in a negotiation
  dmTradeMessage   Boolean @default(true)
  /// DM 15 minutes before an event you've RSVP'd to
  dmEventReminder  Boolean @default(true)
  /// DM when a loot session you participated in completes
  dmLootComplete   Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Fleet Registry ────────────────────────────────────────────────────────────

/// One ship registration per member per ship (uniqued on guildId + userId + shipSlug).
/// Ship data is sourced live from FleetYards.net; slug, name, and manufacturer are
/// denormalised here so the registry is self-contained without an external call.
model FleetEntry {
  id           String   @id @default(cuid())
  guildId      String
  /// Discord user snowflake
  userId       String
  /// Display name at last update
  username     String
  /// FleetYards slug, e.g. "orig-100i"
  shipSlug     String
  /// Denormalised ship display name
  shipName     String
  /// Denormalised manufacturer name
  manufacturer String
  /// How many of this ship the member owns
  quantity     Int      @default(1)
  /// Optional free-text notes (loadout, status, etc.)
  notes        String?
  /// False when member has left the guild; restored on rejoin
  memberActive Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([guildId, userId, shipSlug])
  @@index([guildId, shipSlug])
  @@index([guildId, userId])
  @@index([guildId, memberActive])
}

// ── Kanban Board ──────────────────────────────────────────────────────────────

/// A column on the Development Milestones Kanban board.
model KanbanColumn {
  id        String   @id @default(cuid())
  title     String
  /// Tailwind color key: slate | blue | green | yellow | red | purple | orange
  color     String   @default("slate")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards KanbanCard[]

  @@index([sortOrder])
}

/// A card within a Kanban column.
model KanbanCard {
  id          String   @id @default(cuid())
  columnId    String
  title       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  column KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId, sortOrder])
}

/// FleetYards OAuth connection for a user — stores tokens for hangar import.
/// One row per user (unique on userId). Deleted when the user disconnects.
model FleetyardsLink {
  id           String    @id @default(cuid())
  /// FleetYards username (their canonical identifier)
  fyUserId     String
  fyUsername   String
  accessToken  String
  refreshToken String?
  /// Unix timestamp seconds — when the access token expires
  expiresAt    Int?
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fyUserId])
}

/// Immutable audit log — one row per sync run (scheduled or manual).
model UexSyncLog {
  id                 String    @id @default(cuid())
  /// "SCHEDULED" | "MANUAL"
  trigger            String
  /// Discord snowflake of the admin who triggered a manual sync; null for scheduled.
  triggeredById      String?
  /// "RUNNING" | "SUCCESS" | "FAILED"
  status             String    @default("RUNNING")
  categoriesAdded    Int       @default(0)
  categoriesUpdated  Int       @default(0)
  itemsAdded         Int       @default(0)
  itemsUpdated       Int       @default(0)
  commoditiesAdded   Int       @default(0)
  commoditiesUpdated Int       @default(0)
  /// Populated when status = "FAILED".
  error              String?
  startedAt          DateTime  @default(now())
  completedAt        DateTime?

  @@index([status])
  @@index([startedAt])
}

model RequestLog {
  id         String   @id @default(cuid())
  method     String
  path       String
  module     String
  guildId    String?
  userId     String?
  statusCode Int
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([guildId, createdAt])
  @@index([module, createdAt])
  @@index([createdAt])
}

// ── Tournament Bracket Module ─────────────────────────────────────────────────

model Tournament {
  id                 String    @id @default(cuid())
  guildId            String
  name               String
  description        String?
  /// "SINGLE_ELIM" | "DOUBLE_ELIM"
  format             String    @default("SINGLE_ELIM")
  /// "INDIVIDUAL" | "TEAM"
  participantMode    String    @default("INDIVIDUAL")
  /// Must be a power of 2: 4 | 8 | 16 | 32
  size               Int       @default(8)
  /// "DRAFT" | "REGISTRATION" | "IN_PROGRESS" | "COMPLETED"
  status             String    @default("DRAFT")
  /// "RANDOM" | "DKP" | "ACTIVITY" | "MANUAL"
  seedingMode        String    @default("RANDOM")
  dkpPrize1st        Int       @default(0)
  dkpPrize2nd        Int       @default(0)
  dkpPrize3rd        Int       @default(0)
  /// Discord forum channel snowflake for the tournament thread
  channelId          String?
  /// Discord forum thread snowflake
  threadId           String?
  /// Snowflake of the pinned bracket image message in the thread
  bracketMessageId   String?
  registrationEndsAt DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  participants TournamentParticipant[]
  matches      TournamentMatch[]
  reminders    TournamentReminder[]
  seasons      TournamentSeasonLink[]

  @@index([guildId])
  @@index([guildId, status])
}

model TournamentParticipant {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  displayName  String
  /// null for team-mode participants (identified by displayName only)
  discordId    String?
  seed         Int?
  /// "ACTIVE" | "ELIMINATED" | "WINNER" | "RUNNER_UP" | "THIRD"
  status       String     @default("ACTIVE")
  /// double elimination: true when dropped to losers bracket
  inLosers     Boolean    @default(false)
  placement    Int?
  createdAt    DateTime   @default(now())

  teamMembers TournamentTeamMember[]
  matchesAsA  TournamentMatch[]      @relation("MatchParticipantA")
  matchesAsB  TournamentMatch[]      @relation("MatchParticipantB")
  matchesWon  TournamentMatch[]      @relation("MatchWinner")

  @@unique([tournamentId, discordId])
  @@index([tournamentId])
}

model TournamentTeamMember {
  id            String                @id @default(cuid())
  participantId String
  participant   TournamentParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  discordId     String
  displayName   String

  @@unique([participantId, discordId])
}

model TournamentMatch {
  id               String    @id @default(cuid())
  tournamentId     String
  tournament       Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round            Int
  position         Int
  /// "WINNERS" | "LOSERS" | "GRAND_FINALS"
  bracketSide      String    @default("WINNERS")
  participantAId   String?
  participantBId   String?
  participantA     TournamentParticipant? @relation("MatchParticipantA", fields: [participantAId], references: [id])
  participantB     TournamentParticipant? @relation("MatchParticipantB", fields: [participantBId], references: [id])
  winnerId         String?
  winner           TournamentParticipant? @relation("MatchWinner", fields: [winnerId], references: [id])
  scoreA           Int?
  scoreB           Int?
  /// "PENDING" | "SCHEDULED" | "READY_CHECK" | "IN_PROGRESS" | "AWAITING_RESULT" | "COMPLETED" | "BYE" | "NO_SHOW"
  status           String    @default("PENDING")
  /// cuid of the TournamentMatch where winner advances
  nextMatchId      String?
  /// cuid of the TournamentMatch in losers bracket (double elim only)
  nextLoserMatchId String?
  scheduledAt      DateTime?
  readyA           Boolean   @default(false)
  readyB           Boolean   @default(false)
  checkedInA       Boolean   @default(false)
  checkedInB       Boolean   @default(false)
  /// idempotency guard — prevents double Discord post
  resultPostedAt   DateTime?
  createdAt        DateTime  @default(now())

  @@index([tournamentId, round])
  @@index([scheduledAt, status])
  @@index([tournamentId, bracketSide])
}

model TournamentReminder {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matchId      String?
  /// "MATCH_START" | "CHECK_IN" | "REGISTRATION_CLOSE" | "BRACKET_RELEASE"
  type         String
  scheduledAt  DateTime
  sentAt       DateTime?

  @@index([scheduledAt, sentAt])
  @@index([tournamentId])
}

model TournamentSeason {
  id        String    @id @default(cuid())
  guildId   String
  name      String
  /// "ACTIVE" | "COMPLETED"
  status    String    @default("ACTIVE")
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  createdAt DateTime  @default(now())

  links     TournamentSeasonLink[]
  standings TournamentSeasonStanding[]

  @@index([guildId])
  @@index([guildId, status])
}

model TournamentSeasonLink {
  seasonId     String
  tournamentId String
  season       TournamentSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@id([seasonId, tournamentId])
}

/// All-time ELO per player per guild — never resets
model TournamentPlayerRating {
  id            String   @id @default(cuid())
  guildId       String
  discordId     String
  displayName   String
  rating        Int      @default(1200)
  matchesPlayed Int      @default(0)
  wins          Int      @default(0)
  losses        Int      @default(0)
  peakRating    Int      @default(1200)
  updatedAt     DateTime @updatedAt

  history TournamentRatingHistory[]

  @@unique([guildId, discordId])
  @@index([guildId, rating])
}

/// Season ELO — starts at 1200 each new season
model TournamentSeasonStanding {
  id            String           @id @default(cuid())
  seasonId      String
  guildId       String
  discordId     String
  displayName   String
  rating        Int              @default(1200)
  matchesPlayed Int              @default(0)
  wins          Int              @default(0)
  losses        Int              @default(0)
  season        TournamentSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, discordId])
  @@index([seasonId, rating])
}

/// One row per player per match result — full ELO audit trail
model TournamentRatingHistory {
  id                   String                 @id @default(cuid())
  ratingId             String
  rating               TournamentPlayerRating @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  matchId              String
  tournamentId         String
  ratingBefore         Int
  ratingAfter          Int
  delta                Int
  won                  Boolean
  opponentName         String?
  opponentRatingBefore Int?
  createdAt            DateTime               @default(now())

  @@index([ratingId, createdAt])
  @@index([tournamentId])
}
