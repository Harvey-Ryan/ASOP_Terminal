{
  "name": "@dem/sc-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mirrors StarCitizenWiki/scunpacked-data into Postgres (scdata_raw + scdata schemas). Runs as a Railway cron job and exits.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "tar-stream": "^3.1.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/tar-stream": "^3.1.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
