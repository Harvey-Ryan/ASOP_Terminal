# ── Discord Bot ───────────────────────────────────────────────────────────────
# Create an app at https://discord.com/developers/applications
# Bot section → Token
DISCORD_TOKEN=your_bot_token_here
# OAuth2 section → Client ID
DISCORD_CLIENT_ID=your_client_id_here

# Guild ID for instant slash-command registration during development.
# Remove this line (or leave blank) to register global commands instead
# (global registration can take up to 1 hour to propagate).
GUILD_ID=your_guild_id_here

# ── Database ──────────────────────────────────────────────────────────────────
# Points at the same SQLite file used by apps/api.
# The path is relative to the CWD when the bot process starts (apps/bot/).
DATABASE_URL="file:../api/prisma/dev.db"

# ── Channel / Category IDs ────────────────────────────────────────────────────
# These are used as fallbacks when a guild hasn't been configured via the
# dashboard.  Right-click a channel/category in Discord → Copy Channel ID.

# Forum channel where event threads will be created
FORUM_CHANNEL_ID=your_forum_channel_id_here

# Voice category where 30-min-before VCs will be created
VC_CATEGORY_ID=your_voice_category_id_here

# ── Web app ───────────────────────────────────────────────────────────────────
# Used when building the /event create redirect link
WEB_URL=http://localhost:5173
